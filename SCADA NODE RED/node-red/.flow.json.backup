            [
                "n_plc"
            ]
        ]
    },
    {
        "id": "n_plc",
        "type": "function",
        "z": "tab_destileria",
        "name": "PLC → SCADA / micros",
        "func": "// PLC -> SCADA (+ micros)\nconst modo=flow.get('modo')||'default';\nconst p=msg.payload; if(typeof p!=='object'||p===null) return null;\nconst plc=Object.assign({},flow.get('plc')||{},p); flow.set('plc',plc);\nconst real=(modo==='default'||modo==='manual');\nconst ui=real?{topic:'plc',payload:plc}:null;\nconst ser=[],wf=[];\nif(real){\n  if('rec_sp_des' in p) ser.push({payload:'setpoint:'+Number(p.rec_sp_des)});\n  if('rec_hist_des' in p) ser.push({payload:'hist:'+Number(p.rec_hist_des)});\n  if('act_purgadest' in p) ser.push({payload:'purgadest:'+(p.act_purgadest?1:0)});\n  if('act_purgaferm' in p) ser.push({payload:'purgaferm:'+(p.act_purgaferm?1:0)});\n  if('act_aguadest' in p) ser.push({payload:'agua:'+(p.act_aguadest?1:0)});\n  if('act_vaciado' in p) ser.push({payload:'vaciado:'+(p.act_vaciado?1:0)});\n  const f={};\n  if('rec_sp_fer' in p) f.setpoint=Number(p.rec_sp_fer);\n  if('rec_hist_fer' in p) f.histeresis=Number(p.rec_hist_fer);\n  if('act_valvmosto' in p) f.bomba_mosto=!!p.act_valvmosto;\n  if('act_bombawash' in p) f.valvula_destilador=!!p.act_bombawash;\n  if('act_refrig' in p){ f.auto_refrigeracion=false; f.refrigeracion=!!p.act_refrig; }\n  // Bomba de recirculado (M90.0) y válvula de recirculado (M36.3) = mismo actuador del ESP32\n  if('act_bombarecirc' in p || 'act_valvrecirc' in p) f.recirculado=!!(plc.act_bombarecirc||plc.act_valvrecirc);\n  if(Object.keys(f).length) wf.push({payload:JSON.stringify(f)});\n}\nreturn [ui,ser.length?ser:null,wf.length?wf:null];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 340,
        "wires": [
            [
                "n_ui"
            ],
            [
                "n_serout"
            ],
            [
                "n_wsfout"
            ]
        ]
    },
    {
        "id": "n_serout",
        "type": "serial out",
        "z": "tab_destileria",
        "name": "Comandos Arduino",
        "serial": "cfg_serial",
        "x": 640,
        "y": 300,
        "wires": []
    },
    {
        "id": "n_wsfout",
        "type": "websocket out",
        "z": "tab_destileria",
        "name": "→ ESP32",
        "server": "ws_fer",
        "client": "",
        "x": 640,
        "y": 340,
        "wires": []
    },
    {
        "id": "n_wstout",
        "type": "websocket out",
        "z": "tab_destileria",
        "name": "→ ESP8266 (sin usar: solo tara/cal a mano)",
        "server": "ws_tan",
        "client": "",
        "x": 640,
        "y": 380,
        "wires": []
    },
    {
        "id": "n_cmd",
        "type": "function",
        "z": "tab_destileria",
        "name": "Comandos SCADA",
        "func": "// SCADA -> PLC / micros / SCADA        salidas: [s7 out, serial Arduino, ws ESP32, SCADA]\nconst MANS=['man_wash','man_aguadest','man_purgadest','man_valvrecirc','man_mosto','man_purgaferm','man_refrig','man_vaciado','man_bombarecirc'];\nconst SPS={rec_sp_fer:[0,100],rec_hist_fer:[0,20],rec_sp_des:[0,120],rec_hist_des:[0,20]};\nconst MEDS=['fer_temp','des_temp','fer_vol','des_vol','rec_vol','recir_vol'];\nconst modo=flow.get('modo')||'default';\nconst real=m=>m==='default'||m==='manual';\nswitch(msg.topic){\n case 'hello':{\n   const out=[{topic:'status',payload:{modo}}];\n   if(modo==='pruebas'){ const ps=flow.get('prueba'); if(ps) out.push({topic:'plc',payload:ps}); }\n   else if(real(modo)){ const plc=flow.get('plc'); if(plc) out.push({topic:'plc',payload:plc}); }\n   return [null,null,null,out];\n }\n case 'modo':{\n   const m=String(msg.payload);\n   if(!['default','manual','simulacion','pruebas'].includes(m)) return null;\n   flow.set('modo',m);\n   const out=[{topic:'status',payload:{modo:m}}];\n   if(m==='simulacion') flow.set('sim',null);\n   if(m==='pruebas'){ const ps=Object.assign({},flow.get('plc')||{}); flow.set('prueba',ps); out.push({topic:'plc',payload:ps}); }\n   if(real(m)){ const plc=flow.get('plc'); if(plc) out.push({topic:'plc',payload:plc}); }\n   // ModoManual del PLC: 1 solo en modo Manual\n   return [[{variable:'modo_manual',payload:m==='manual'}],null,null,out];\n }\n case 'manual':{\n   if(modo!=='manual') return null;\n   const p=msg.payload||{}; if(!MANS.includes(p.name)) return null;\n   return [[{variable:p.name,payload:!!p.value}],null,null,null];\n }\n case 'btn':{\n   if(!real(modo)) return null;\n   const v={iniciar:'btn_iniciar',extraer:'btn_extraer'}[msg.payload]; if(!v) return null;\n   node.send([[{variable:v,payload:true}],null,null,null]);\n   setTimeout(()=>node.send([[{variable:v,payload:false}],null,null,null]),500);\n   return null;\n }\n case 'set_sp':{                       // solo en automático (Default)\n   if(modo!=='default') return null;\n   const p=msg.payload||{}, r=SPS[p.name], v=Number(p.value);\n   if(!r||!isFinite(v)||v<r[0]||v>r[1]) return null;\n   const wr=[{variable:p.name,payload:v}];\n   const ser={rec_sp_des:'setpoint:'+v,rec_hist_des:'hist:'+v}[p.name];\n   const ws={rec_sp_fer:{setpoint:v},rec_hist_fer:{histeresis:v}}[p.name];\n   return [wr,ser?{payload:ser}:null,ws?{payload:JSON.stringify(ws)}:null,null];\n }\n case 'test_set':{                     // solo en Pruebas: se guarda y las medidas/consignas también van al PLC\n   if(modo!=='pruebas') return null;\n   const p=msg.payload||{}; const ps=flow.get('prueba')||{};\n   if(typeof p.name!=='string') return null;\n   ps[p.name]=p.value; flow.set('prueba',ps);\n   if(MEDS.includes(p.name)||p.name in SPS){ const v=Number(p.value); if(isFinite(v)) return [[{variable:p.name,payload:v}],null,null,null]; }\n   return null;\n }\n}\nreturn null;",
