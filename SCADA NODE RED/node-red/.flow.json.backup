                "n_ui"
            ],
            [
                "h_file"
            ]
        ]
    },
    {
        "id": "h_http",
        "type": "http in",
        "z": "tab_destileria",
        "name": "GET /scada-api/csv/:tipo",
        "url": "/scada-api/csv/:tipo",
        "method": "get",
        "upload": false,
        "swaggerDoc": "",
        "x": 150,
        "y": 740,
        "wires": [
            [
                "h_csv"
            ]
        ]
    },
    {
        "id": "h_csv",
        "type": "function",
        "z": "tab_destileria",
        "name": "Historial: CSV",
        "func": "// GET /scada-api/csv/historial  -> CSV para Excel (separador ; y coma decimal)\nconst H=flow.get('H')||{hist:[],ev:[]};\nconst tipo=(msg.req&&msg.req.params&&msg.req.params.tipo)||'';\nconst pad=x=>String(x).padStart(2,'0');\nconst fh=t=>{const d=new Date(t);return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+' '+pad(d.getHours())+':'+pad(d.getMinutes())+':'+pad(d.getSeconds());};\nconst num=v=>(v==null||!isFinite(v))?'':String(v).replace('.',',');\nconst esc=v=>{v=String(v);return /[;\"\\n]/.test(v)?'\"'+v.replace(/\"/g,'\"\"')+'\"':v;};\nlet rows;\nif(tipo==='historial'){\n  rows=[['Fecha y hora','Temp fermentador (C)','Temp destilador (C)','Vol fermentador (L)','Vol destilador (L)','Vol trasiega (L)','Vol recirculado (L)','Modo']]\n    .concat(H.hist.map(p=>[fh(p.t),num(p.ft),num(p.dt),num(p.fv),num(p.dv),num(p.rv),num(p.cv),p.m||'']));\n}else{ msg.statusCode=404; msg.payload='No existe'; return msg; }\nconst d=new Date();\nmsg.statusCode=200;\nmsg.headers={'Content-Type':'text/csv; charset=utf-8','Content-Disposition':'attachment; filename=\"'+tipo+'_'+d.getFullYear()+pad(d.getMonth()+1)+pad(d.getDate())+'.csv\"'};\nmsg.payload='﻿'+rows.map(r=>r.map(esc).join(';')).join('\\r\\n')+'\\r\\n';\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 740,
        "wires": [
            [
                "h_res"
            ]
        ]
    },
