    {
        "id": "h_muestra",
        "type": "function",
        "z": "tab_destileria",
        "name": "Historial: muestrear",
        "func": "// Historial (servidor): cada 5 s toma una muestra del estado actual, detecta fases/alarmas y guarda todo en historial_scada.json\n// En modo Pruebas no se registra nada (son datos inventados). Ciclos y litros solo cuentan en Default/Manual.\nconst MAXH=8640, MAXE=300;                       // 12 h de muestras (1 cada 5 s) y 300 eventos\nconst ALMS={alm_sobrecalentado:'Fermentador sobrecalentado',alm_ferm_lleno:'Fermentador lleno',alm_demasiado_wash:'Demasiado wash en el destilador',alm_aviso_metanol:'Aviso de descarte de metanol',alerta_agua_baja:'Agua baja en el destilador',alm_falla_uss:'Falla USS'};\nconst FASES={fase_ferm_terminada:'Fermentación terminada',fase_limpieza_ini:'Limpieza del fermentador',fase_inicio_destilado:'Pesaje previo al clarificado',fase_inicio_clarificado:'Clarificado (agregado de agua)',fase_descarte_metanol:'Descarte de metanol',fase_descarte_exitoso:'Descarte exitoso',fase_inicio_recirculado:'Recirculado',fase_fin_recirculado:'Fin de recirculado',fase_whisky_terminado:'Whisky terminado'};\nconst modo=flow.get('modo')||'default';\nconst real=modo==='default'||modo==='manual';\nconst S=real?flow.get('plc'):(modo==='simulacion'?flow.get('simplc'):null);\nif(!S||(S.fer_temp==null&&S.des_temp==null)){ flow.set('Hprev',null); return null; }\nconst H=flow.get('H')||{hist:[],ev:[],ciclos:0,litros:0};\nconst now=Date.now(), r=x=>(x==null||!isFinite(x))?null:Math.round(x*100)/100;\nH.hist.push({t:now,ft:r(S.fer_temp),dt:r(S.des_temp),fv:r(S.fer_vol),dv:r(S.des_vol),rv:r(S.rec_vol),cv:r(S.recir_vol),m:modo});\nif(H.hist.length>MAXH) H.hist.splice(0,H.hist.length-MAXH);\nconst prev=flow.get('Hprev');\nconst cur={modo,rec:S.rec_vol,f:{}};\nfor(const k of [...Object.keys(ALMS),...Object.keys(FASES)]) cur.f[k]=!!S[k];\nlet cambio=false;\nif(prev&&prev.modo===modo){\n  for(const k in cur.f) if(cur.f[k]!==prev.f[k]){\n    H.ev.unshift({t:now,txt:ALMS[k]||FASES[k],on:cur.f[k],alm:k in ALMS,modo});\n    if(real&&k==='fase_whisky_terminado'&&cur.f[k]) H.ciclos++;\n    cambio=true;\n  }\n  if(real&&S.act_vaciado&&prev.rec!=null&&S.rec_vol!=null&&S.rec_vol<prev.rec) H.litros+=prev.rec-S.rec_vol;\n}\nif(H.ev.length>MAXE) H.ev.length=MAXE;\nflow.set('Hprev',cur); flow.set('H',H);\nconst n=(flow.get('Hn')||0)+1; flow.set('Hn',n);\nif(cambio||n%12===0) return {payload:JSON.stringify(H)};   // se escribe a disco al haber eventos y cada 60 s\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 600,
        "wires": [
