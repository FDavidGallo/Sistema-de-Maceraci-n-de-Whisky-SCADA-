    {
        "id": "h_carga",
        "type": "function",
        "z": "tab_destileria",
        "name": "Historial: cargar",
        "func": "// Al arrancar: recupera el historial guardado en historial_scada.json\ntry{\n  const H=JSON.parse(String(msg.payload));\n  if(H&&Array.isArray(H.hist)&&Array.isArray(H.ev)){\n    H.ciclos=Number(H.ciclos)||0; H.litros=Number(H.litros)||0;\n    flow.set('H',H); node.status({fill:'green',shape:'dot',text:H.hist.length+' muestras / '+H.ev.length+' eventos'});\n  }\n}catch(e){ node.warn('historial_scada.json ilegible, se empieza de cero'); }\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 660,
        "wires": [
            []
        ]
    },
    {
        "id": "h_req",
        "type": "function",
        "z": "tab_destileria",
        "name": "Historial: pedidos SCADA",
        "func": "// Pedidos del SCADA al historial.   salidas: [SCADA, archivo]\nconst vacio=()=>({hist:[],ev:[],ciclos:0,litros:0});\nconst H=flow.get('H')||vacio();\nif(msg.topic==='get_hist'){\n  const since=Number((msg.payload||{}).since)||0;\n  msg.topic='hist';                                   // se conserva msg._uib: responde solo al que pidió\n  msg.payload={full:since===0,hist:since?H.hist.filter(p=>p.t>since):H.hist,ev:H.ev,ciclos:H.ciclos,litros:H.litros};\n  return [msg,null];\n}\nif(msg.topic==='clear_hist'){\n  const nuevo=vacio(); flow.set('H',nuevo); flow.set('Hprev',null);\n  return [{topic:'hist_cleared',payload:true},{payload:JSON.stringify(nuevo)}];   // sin _uib: avisa a todas las páginas\n}\nreturn null;\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 880,
        "y": 720,
        "wires": [
