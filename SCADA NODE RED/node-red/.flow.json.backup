    {
        "id": "n_s7in",
        "type": "s7 in",
        "z": "tab_destileria",
        "endpoint": "cfg_s7",
        "mode": "all",
        "variable": "",
        "diff": true,
        "name": "Leer PLC",
        "x": 120,
