    {
        "id": "n_sim",
        "type": "function",
        "z": "tab_destileria",
        "name": "Simulador de ciclo",
        "func": "// Simulador de un ciclo normal (solo con modo = simulacion). No toca PLC ni micros.\nif((flow.get('modo')||'default')!=='simulacion') return null;\nconst plc=flow.get('plc')||{};\nlet s=flow.get('sim');\nif(!s) s={ph:0,t:0,cic:0,cool:0,v:{fer_temp:24,des_temp:22,fer_vol:0,des_vol:0.3,rec_vol:0,recir_vol:0}};\nconst v=s.v; s.t++;\nconst A={act_bombawash:0,act_aguadest:0,act_purgadest:0,act_valvrecirc:0,act_resistencia:0,act_valvmosto:0,act_purgaferm:0,act_refrig:0,act_vaciado:0,act_bombarecirc:0};\nconst F={fer_llenando:0,alm_aviso_metanol:0};\nconst SPF=20,HF=0.5,SPD=88; let fase='En espera';\nconst go=n=>{s.ph=n;s.t=0};\nswitch(s.ph){\n case 0: fase='Ingreso de mosto'; A.act_valvmosto=1;F.fer_llenando=1; v.fer_vol=Math.min(50,v.fer_vol+2.5); v.fer_temp+=(24-v.fer_temp)*0.1; if(v.fer_vol>=50) go(1); break;\n case 1: fase='Fermentación'; if(v.fer_temp>SPF+HF) s.cool=1; else if(v.fer_temp<SPF-HF) s.cool=0; if(s.t<3) s.cool=1;\n   A.act_refrig=s.cool; v.fer_temp+=s.cool?-0.35:0.25; if(s.t>=25) go(2); break;\n case 2: fase='Trasvase de wash al destilador'; A.act_bombawash=1; v.fer_vol=Math.max(0,v.fer_vol-2.5); v.des_vol+=1.9; if(v.fer_vol<=0.2) go(3); break;\n case 3: fase='Limpieza del fermentador'; A.act_purgaferm=1; if(s.t>=4) go(4); break;\n case 4: fase='Clarificado (agregando agua)'; A.act_aguadest=1; v.des_vol+=0.57; if(s.t>=10) go(5); break;\n case 5: fase=s.cic?'Redestilado':'Destilando'; A.act_resistencia=1;\n   v.des_temp=Math.max(20,Math.min(95,v.des_temp+(SPD+Math.sin(s.t/2)*0.6-v.des_temp)*0.06));\n   if(s.cic===0&&s.t<=5){A.act_purgadest=1;F.alm_aviso_metanol=1;fase='Descarte de metanol';}\n   if(s.t>5&&v.des_temp>80){v.des_vol=Math.max(5,v.des_vol-0.9);v.rec_vol+=0.8;}\n   if(v.des_vol<=5||s.t>=90) go(s.cic<1?6:7); break;\n case 6: fase='Recirculando'; A.act_bombarecirc=1;A.act_valvrecirc=1; v.rec_vol=Math.max(0,v.rec_vol-1.5); v.des_vol+=1.5;\n   if(v.rec_vol<=0.2){s.cic++;go(5);} break;\n case 7: fase='Extracción a la barrica'; A.act_vaciado=1; v.des_temp+=(25-v.des_temp)*0.1; v.rec_vol=Math.max(0,v.rec_vol-1.8); if(v.rec_vol<=0) go(8); break;\n case 8: fase='Whisky terminado'; if(s.t>=6){ s={ph:0,t:0,cic:0,cool:0,v:{fer_temp:24,des_temp:22,fer_vol:0,des_vol:0.3,rec_vol:0,recir_vol:0}}; } break;\n}\nif(s.ph===6) v.recir_vol=Math.min(8,v.recir_vol+1); else v.recir_vol=Math.max(0,v.recir_vol-1);\nflow.set('sim',s);\nconst r=x=>Math.round(x*100)/100, o={};\nfor(const k in v) o[k]=r(v[k]);\nconst P=s.ph,C=s.cic,FL={fase_ferm_terminada:P>=2&&P<8?1:0,fase_limpieza_ini:P>=3&&P<8?1:0,fase_limpieza_fin:P>=4&&P<8?1:0,fase_inicio_destilado:P>=4&&P<8?1:0,fase_inicio_clarificado:P>=4&&P<8?1:0,fase_descarte_metanol:P>=5&&P<8?1:0,fase_descarte_exitoso:P>=6&&P<8?1:0,fase_inicio_recirculado:(P>=6||C>0)&&P<8?1:0,fase_fin_recirculado:(C>0||P>=7)&&P<8?1:0,fase_whisky_terminado:P>=8?1:0};\nconst out=Object.assign(o,A,F,FL,{rec_nombre:plc.rec_nombre||'Irlandes',rec_sp_fer:SPF,rec_hist_fer:HF,rec_sp_des:SPD,rec_hist_des:1,modo_manual:false,fase_txt:fase});\nflow.set('simplc',out);\nreturn {topic:'plc',payload:out};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
