    {
        "id": "n_f_ard",
        "type": "function",
        "z": "tab_destileria",
        "name": "Micro arduino → PLC",
        "func": "const SRC='arduino';\nlet d=msg.payload;\nif(typeof d==='string'){const s=d.trim(); if(!s.startsWith('{')) return null; try{d=JSON.parse(s)}catch(e){return null}}\nif(typeof d!=='object'||d===null) return null;\nconst modo=flow.get('modo')||'default';\nflow.set('m_'+SRC,d);\nif(modo==='simulacion'||modo==='pruebas') return [null,null];   // micros \"desconectados\"\nconst w=[]; const add=(v,x)=>{ if(x!==null&&x!==undefined&&isFinite(x)) w.push({variable:v,payload:Number(x)}) };\nconst ser=[];\nif(SRC==='arduino'){ if(d.temperatura_actual===undefined) return null; if(d.sensor_ok!==false) add('des_temp',d.temperatura_actual); add('des_vol',d.peso_litros);\n  // Purgas: si el Arduino informa un estado distinto al del PLC (p.ej. reinicio del micro), se le reenvia el del PLC\n  const plc=flow.get('plc')||{};\n  if(d.purga_destilador!==undefined && plc.act_purgadest!==undefined && !!d.purga_destilador!==!!plc.act_purgadest) ser.push({payload:'purgadest:'+(plc.act_purgadest?1:0)});\n  if(d.purga_fermentador!==undefined && plc.act_purgaferm!==undefined && !!d.purga_fermentador!==!!plc.act_purgaferm) ser.push({payload:'purgaferm:'+(plc.act_purgaferm?1:0)});\n  if(d.valvula_vaciado!==undefined && plc.act_vaciado!==undefined && !!d.valvula_vaciado!==!!plc.act_vaciado) ser.push({payload:'vaciado:'+(plc.act_vaciado?1:0)});\n  if(d.bomba_agua!==undefined && plc.act_aguadest!==undefined && !!d.bomba_agua!==!!plc.act_aguadest) ser.push({payload:'agua:'+(plc.act_aguadest?1:0)});\n}\nif(SRC==='esp32'){ if(d.sensor_ok!==false) add('fer_temp',d.temperatura_actual); }\nif(SRC==='esp8266'){ add('fer_vol',d.fermentador_litros); if(d.recepcion_ok!==false) add('rec_vol',d.recepcion_litros); if(d.recirculado_ok!==false) add('recir_vol',d.recirculado_litros); }\nreturn [w.length?w:null,{topic:'micro',payload:{src:SRC}},ser.length?ser:null];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 120,
        "wires": [
            [
                "n_s7out"
            ],
            [
                "n_ui"
            ],
            [
                "n_serout"
            ]
        ]
    },
    {
        "id": "n_f_esp32",
        "type": "function",
        "z": "tab_destileria",
        "name": "Micro esp32 → PLC",
        "func": "const SRC='esp32';\nlet d=msg.payload;\nif(typeof d==='string'){const s=d.trim(); if(!s.startsWith('{')) return null; try{d=JSON.parse(s)}catch(e){return null}}\nif(typeof d!=='object'||d===null) return null;\nconst modo=flow.get('modo')||'default';\nflow.set('m_'+SRC,d);\nif(modo==='simulacion'||modo==='pruebas') return [null,null];   // micros \"desconectados\"\nconst w=[]; const add=(v,x)=>{ if(x!==null&&x!==undefined&&isFinite(x)) w.push({variable:v,payload:Number(x)}) };\nif(SRC==='arduino'){ if(d.temperatura_actual===undefined) return null; if(d.sensor_ok!==false) add('des_temp',d.temperatura_actual); add('des_vol',d.peso_litros); }\nif(SRC==='esp32'){ if(d.sensor_ok!==false) add('fer_temp',d.temperatura_actual); }\nif(SRC==='esp8266'){ add('fer_vol',d.fermentador_litros); if(d.recepcion_ok!==false) add('rec_vol',d.recepcion_litros); if(d.recirculado_ok!==false) add('recir_vol',d.recirculado_litros); }\nreturn [w.length?w:null,{topic:'micro',payload:{src:SRC}}];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 180,
        "wires": [
            [
                "n_s7out"
            ],
            [
                "n_ui"
            ]
        ]
    },
    {
        "id": "n_f_esp8266",
        "type": "function",
        "z": "tab_destileria",
        "name": "Micro esp8266 → PLC",
        "func": "const SRC='esp8266';\nlet d=msg.payload;\nif(typeof d==='string'){const s=d.trim(); if(!s.startsWith('{')) return null; try{d=JSON.parse(s)}catch(e){return null}}\nif(typeof d!=='object'||d===null) return null;\nconst modo=flow.get('modo')||'default';\nflow.set('m_'+SRC,d);\nif(modo==='simulacion'||modo==='pruebas') return [null,null];   // micros \"desconectados\"\nconst w=[]; const add=(v,x)=>{ if(x!==null&&x!==undefined&&isFinite(x)) w.push({variable:v,payload:Number(x)}) };\nif(SRC==='arduino'){ if(d.temperatura_actual===undefined) return null; if(d.sensor_ok!==false) add('des_temp',d.temperatura_actual); add('des_vol',d.peso_litros); }\nif(SRC==='esp32'){ if(d.sensor_ok!==false) add('fer_temp',d.temperatura_actual); }\nif(SRC==='esp8266'){ add('fer_vol',d.fermentador_litros); if(d.recepcion_ok!==false) add('rec_vol',d.recepcion_litros); if(d.recirculado_ok!==false) add('recir_vol',d.recirculado_litros); }\nreturn [w.length?w:null,{topic:'micro',payload:{src:SRC}}];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 240,
        "wires": [
